<div class="profile-header d-flex align-items-center mb-4">
  <img src="https://via.placeholder.com/150" class="rounded-circle me-4" width="120" height="120" alt="Profile Picture">
  <div>
    <h2><%= @account.email %></h2>
    <p class="text-muted">Bio: Soon to be added...</p>
    <p><strong><%= @posts.count %></strong> Posts</p>
  </div>
</div>

<div class="row">
  <% @posts.each do |post| %>
    <div class="col-md-4 mb-3">
      <div class="card bg-dark text-light">
        <%= image_tag post.image_url, class: "card-img-top" if post.image_url.present? %>
        <div class="card-body">
          <p class="card-text"><%= post.caption %></p>
        </div>
      </div>
    </div>
  <% end %>
</div>
